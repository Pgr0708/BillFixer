{
  "name": "billfixer-backend",
  "version": "1.0.0",
  "description": "BillFixer API — medical bill analysis backend (Node.js, MySQL, Redis)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "migrate:seed": "node db/migrate.js --seed",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lru-cache": "^11.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
