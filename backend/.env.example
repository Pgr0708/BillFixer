# ─────────────────────────────────────────────────────────────
# BillFixer backend — copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Number of reverse proxies in front of the app (nginx = 1)
TRUST_PROXY=1
PUBLIC_BASE_URL=https://billfixer.dakshyaminfotech.store
CORS_ORIGINS=https://billfixer.dakshyaminfotech.store
LOG_LEVEL=info

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=billfixer
DB_PASSWORD=change-me
DB_NAME=billfixer
# Connections per Node process. PM2 runs one process per CPU core,
# so total = DB_POOL_SIZE x cores. Keep total under MySQL max_connections.
DB_POOL_SIZE=10
# Optional read replica for SELECTs (horizontal read scaling). Leave blank to use primary.
DB_READ_HOST=

# ── Redis (optional — the API keeps working if Redis is down) ──
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=bf:

# ── Auth ──────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-random-chars-replace-with-64-random-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
JWT_ISSUER=billfixer-api
JWT_AUDIENCE=billfixer-ios
# Comma-separated iOS bundle IDs allowed as the Sign in with Apple audience
APPLE_BUNDLE_IDS=com.bhavik.BillFixer

# ── LLM (OpenAI) — server-side only, never shipped in the app ──
LLM_ENABLED=true
OPENAI_API_KEY=
# gpt-4o-mini or o4-mini — both supported. Change here, no code change needed.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=30000

# ── RevenueCat (subscriptions) ────────────────────────────────
# Secret API key (sk_...) from RevenueCat → Project settings → API keys
REVENUECAT_SECRET_KEY=
# Any long random string; paste the same value into RevenueCat → Integrations → Webhooks → Authorization header
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=pro

# ── Email (Hostinger SMTP) — needed only for password reset ────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BillFixer <no-reply@dakshyaminfotech.store>"

# ── Limits ────────────────────────────────────────────────────
FREE_ACTIVE_CASE_LIMIT=1
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_LLM_PER_HOUR=30
